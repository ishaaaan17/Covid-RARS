{
  "schema_version": 2,
  "source": {
    "repository": "https://github.com/Rofiquldk1/COVID-19-Detection-from-Cough-Sound",
    "paper": "Robust COVID-19 detection from cough sounds using deep neural decision tree and forest: A comprehensive cross-datasets evaluation",
    "journal": "Expert Systems with Applications",
    "year": 2026,
    "doi": "10.1016/j.eswa.2026.131235",
    "arxiv": "2501.01117"
  },
  "paths": {
    "coswara_features": "data/processed/features_compare_is10_merged.csv",
    "coughvid_features": "data/processed/features_compare_is10_coughvid_cough_top800.csv",
    "output_directory": "reports/dndf"
  },
  "architecture": {
    "dndt": {
      "depth": 11,
      "used_features_rate": 1.0,
      "num_classes": 2,
      "temperature": 1.0
    },
    "dndf": {
      "num_trees": 25,
      "depth": 11,
      "used_features_rate": 0.8,
      "num_classes": 2,
      "temperature": 1.0
    }
  },
  "training": {
    "learning_rate": 0.01,
    "weight_decay": 1e-4,
    "batch_size": 16,
    "max_epochs": 14,
    "patience": 5,
    "use_smote": true,
    "feature_selection": "rfecv_extratrees",
    "n_selected_features": 33,
    "optimizer": "adamw",
    "loss": "cross_entropy"
  },
  "experiment": {
    "name": "dndf_3track_benchmark_and_reliability",
    "primary_modalities": ["cough"],
    "secondary_modalities": ["breath", "speech"],
    "seeds": [1, 2, 5, 12, 40, 52, 72, 2002, 4002, 6002],
    "tracks": [
      "track1_author_exact_reproduction_10fold",
      "track2_corrected_leak_free_10fold",
      "track3_clinical_reliability_suite"
    ]
  },
  "fusion": {
    "methods": ["uniform_mean", "validation_weighted", "stacked_logistic"],
    "hybrid_comparator_weights": {
      "dndf": 0.5,
      "comparator": 0.5
    }
  }
}
